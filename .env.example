# ─── Service auth ────────────────────────────────────────────────────────────
AI_SERVICE_TOKEN=change-me-to-a-32-char-plus-random-secret

# ─── Permitted evidence storage hosts (comma-separated) ──────────────────────
# The AI service only downloads evidence from these hostnames
EVIDENCE_STORAGE_HOSTS=localhost,s3.amazonaws.com,storage.googleapis.com

# Local dev: allow http for MinIO
ALLOW_LOCAL_STORAGE=true

# ─── Upload size limit (bytes) ────────────────────────────────────────────────
MAX_UPLOAD_BYTES=104857600

# ─── FFmpeg / Tesseract paths (default: system PATH) ─────────────────────────
# FFMPEG_PATH=ffmpeg
# TESSERACT_PATH=tesseract

# ─── Speech-to-text provider ─────────────────────────────────────────────────
# SPEECH_API_URL=https://api.openai.com/v1/audio/transcriptions
# SPEECH_API_KEY=sk-...
# SPEECH_MODEL=whisper-1

# ─── Vision / embedding provider (future) ────────────────────────────────────
# VISION_API_URL=
# VISION_API_KEY=
# EMBEDDING_API_URL=
# EMBEDDING_API_KEY=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8000
